# Raspberry Pi defaults for llama-server.service (Phase 5).
# Install (Task 3.5) copies this file to /etc/shellclaw/llama-server.env.
#
# To swap model: point MODEL= at a different GGUF under /var/lib/shellclaw/models/
# (filenames from scripts/download_model.sh), then restart llama-server.service:
#   systemctl --user restart llama-server.service

MODEL=/var/lib/shellclaw/models/tinyllama-1.1b-chat-Q4_K_M.gguf
THREADS=4
NGL=0
PORT=8080
CTX_SIZE=2048
